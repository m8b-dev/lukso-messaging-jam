# All VITE_ variables are PUBLIC in the browser bundle. Never put private keys
# or reusable service credentials here. Copy to ignored .env.local if needed.
VITE_BASE=/
VITE_BLOBS_ENABLED=1
VITE_CREDITS_PANEL=1
# Optional same-origin reverse-proxy path (VPN deployment only):
# VITE_CREDIT_RELAYER_URL=/vpn/creditrelay
# VITE_BLOB_RELAYER_URL=/vpn/blobrelay
# VITE_BEACON_URL=/vpn/beacon
